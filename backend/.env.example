# ---------------------------------------------------------------------------
# BMIS backend environment configuration (example)
# Copy to .env and replace every placeholder before running the server.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MySQL / MariaDB connection string.
# The database must already exist and the user must be able to read/write it.
DATABASE_URL="mysql://bmis_user:change-me@127.0.0.1:3306/bmis"

# Session cookie signing secret. Generate with: openssl rand -base64 48
# MUST be at least 32 characters and MUST be unique per environment.
SESSION_SECRET="replace-with-a-random-48-byte-base64-secret"

# Session settings
SESSION_COOKIE_NAME=bmis.sid
SESSION_TTL_MINUTES=480

# Only enable over HTTPS. Forced to true automatically when NODE_ENV=production.
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGIN=http://localhost:5173

# Set to true only when the API runs behind a trusted reverse proxy (nginx, etc.)
TRUST_PROXY=false

# Password hashing cost. 12 is a safe default; 10 is a reasonable minimum.
BCRYPT_ROUNDS=12

# Account lockout policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Set to true only for automated tests. Never in production.
RATE_LIMIT_DISABLED=false

# Development seed password. Only used by `npm run db:seed`, which refuses to
# run when NODE_ENV=production. Change it in local .env if you prefer.
SEED_DEFAULT_PASSWORD="BmisDev!2026#"
